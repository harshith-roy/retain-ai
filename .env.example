# =============================================================================
# RETAIN.AI environment variables â€” copy to .env (local) and fill in values.
# This file contains PLACEHOLDERS ONLY. Never commit real keys or credentials.
# =============================================================================

# --- Browser (public) Firebase web-app configuration -------------------------
# Firebase Console â†’ Project settings â†’ General â†’ Your apps â†’ Web app â†’ Config
# These are public by design and safe to expose to the browser.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# Optional â€” analytics is not required for auth or Firestore:
VITE_FIREBASE_MEASUREMENT_ID=

# --- Server-only secrets (never expose to the browser) -----------------------

# Firebase service account JSON (single line) for trusted server-side
# Firestore writes. Needs the Cloud Datastore User IAM role.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# PayPal Sandbox REST app credentials and the plan used by the demo journey
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_PLAN_ID=P-XXXXXXXXXXXXXXXXXXXXXXXX

# AI retention offers: website scraping + offer generation
FIRECRAWL_API_KEY=fc-your-firecrawl-key
GROQ_API_KEY=gsk_your-groq-key

# HMAC secret used to sign AI retention offers (any long random string)
RETAIN_SIGNING_SECRET=generate-a-long-random-string

# Slack approvals: channel that receives approval alerts
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APPROVAL_CHANNEL=C0123456789

# Resend transactional email (requires a verified sending domain)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=RETAIN.AI <notifications@your-verified-domain.com>

# Inngest durable workflows (event key sends events; signing key verifies requests)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxx

# ElevenLabs voice playback of retention offers
ELEVENLABS_API_KEY=sk_your-elevenlabs-key

# PostHog server-side analytics
POSTHOG_API_KEY=phc_your-posthog-key
POSTHOG_REGION=eu

